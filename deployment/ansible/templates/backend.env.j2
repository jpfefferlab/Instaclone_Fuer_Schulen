TZ={{ tz }}

# Database — read individually by InstaClone/settings.py
DB_NAME={{ postgres_db }}
DB_USER={{ postgres_user }}
DB_PASSWORD={{ postgres_password }}
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}

# Django
SECRET_KEY={{ django_secret_key }}
ALLOWED_HOSTS={{ django_allowed_hosts }}
DEBUG={{ django_debug }}

# Gunicorn worker count — formula: vCPUs * 2 + 1 (standard recommendation)
WEB_CONCURRENCY={{ ansible_processor_vcpus * 2 + 1 }}

# S3-compatible object storage for post/story images
# These settings match the Django defaults for AWS S3 production use.
AWS_STORAGE_BUCKET_NAME={{ aws_s3_bucket_name }}
AWS_S3_REGION_NAME={{ aws_s3_region_name }}
AWS_S3_ACCESS_KEY_ID={{ aws_s3_access_key_id }}
AWS_S3_SECRET_ACCESS_KEY={{ aws_s3_secret_access_key }}
{% if aws_s3_endpoint_url %}
AWS_S3_ENDPOINT_URL={{ aws_s3_endpoint_url }}
{% endif %}
{% if aws_s3_public_endpoint_url %}
AWS_S3_PUBLIC_ENDPOINT_URL={{ aws_s3_public_endpoint_url }}
{% endif %}
AWS_S3_USE_SSL={{ aws_s3_use_ssl }}
AWS_S3_VERIFY={{ aws_s3_verify }}
AWS_S3_ADDRESSING_STYLE={{ aws_s3_addressing_style }}
