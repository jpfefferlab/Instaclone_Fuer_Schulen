            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def fullUrl = vars.get(&quot;next_page_post&quot;)

if (fullUrl != null &amp;&amp; !fullUrl.equalsIgnoreCase(&quot;null&quot;)) {
    def uri = new URI(fullUrl)
    def query = uri.getQuery()

    def pageNumber = null
    if (query) {
        def params = query.split(&apos;&amp;&apos;)
        params.each { param -&gt;
            if (param.startsWith(&quot;page=&quot;)) {
                pageNumber = param.substring(&quot;page=&quot;.length())
            }
        }
    }

    vars.put(&quot;next_page_post_clean&quot;, pageNumber ?: &quot;null&quot;)
} else {
    vars.put(&quot;next_page_post_clean&quot;, &quot;null&quot;)
}
</stringProp>
